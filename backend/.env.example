# For running the backend directly on your machine (not via Docker Compose).
# Copy to backend/.env - the API and worker read it from the working directory.

DATABASE_URL=postgresql+psycopg://driftradar:CHANGE_ME@localhost:5432/driftradar
MONGO_URL=mongodb://localhost:27017
MONGO_DB=driftradar
# REQUIRED, >= 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Abuse limits
LOGIN_RATE_LIMIT_PER_MINUTE=10
MANUAL_CHECK_COOLDOWN_SECONDS=10

# Outbound monitoring safeguards
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_MAX_RETRIES=1
MONITOR_MAX_CONCURRENCY=5
MONITOR_MIN_INTERVAL_SECONDS=30
MONITOR_MAX_TIMEOUT_SECONDS=30
# DEMO ONLY - exact hostnames exempt from the public-IP check (e.g. "localhost" for a local mock API)
MONITOR_ALLOWED_HOSTS=

SNAPSHOT_RETENTION_DAYS=14
WORKER_RECONCILE_SECONDS=30
