# Copy to .env and fill in the REQUIRED values. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use URL-safe characters for the database passwords (they are embedded in connection URLs).

# --- REQUIRED ---------------------------------------------------------------
POSTGRES_PASSWORD=
MONGO_ROOT_PASSWORD=
# At least 32 characters; the API refuses to start otherwise.
JWT_SECRET=

# --- Optional (defaults shown) ----------------------------------------------
POSTGRES_USER=driftradar
POSTGRES_DB=driftradar
MONGO_ROOT_USER=driftradar
MONGO_DB=driftradar
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Browser origins allowed to call the API directly (the bundled nginx proxy is same-origin).
CORS_ORIGINS=http://localhost:8080
MONITOR_MAX_CONCURRENCY=5
MONITOR_MIN_INTERVAL_SECONDS=30
SNAPSHOT_RETENTION_DAYS=14

# DEMO ONLY: exact hostnames exempt from the public-IP SSRF check.
# Set to "mock-api" to run docs/demo-walkthrough.md; leave EMPTY otherwise.
MONITOR_ALLOWED_HOSTS=
