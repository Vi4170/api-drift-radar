# Base URL of the backend API as seen by the browser.
# Default "/api/v1" works with the Vite dev proxy and the Docker nginx proxy (same origin, no CORS).
# Set a full URL (e.g. https://api.example.com/api/v1) only if the API is served from another origin,
# and add that frontend origin to the backend's CORS_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Dev server only: where Vite proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:8000
